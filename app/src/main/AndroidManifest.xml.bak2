<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.ffalcon.thirdeye.demo">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:name=".ThirdEyeApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ThirdEye"
        tools:targetApi="31">

        <meta-data
            android:name="com.rayneo.mercury.app"
            android:value="true" />

        <activity
            android:name=".DemoHomeActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <!-- Intent filter to show app in launcher/app drawer -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- HOME intent filter removed to prevent Android 12 AOSP bug:
                 Intent Filter Verification Service crash due to WorkManager 10KB data limit.
                 If you need launcher functionality, use programmatic assignment via ADB:
                 adb shell cmd package set-home-activity com.ffalcon.thirdeye.demo/.DemoHomeActivity

                 AOSP Bug Reference: https://android.googlesource.com/platform/frameworks/base/+/4978d1ad
            -->
            <!-- REMOVED TO PREVENT CRASH:
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            -->
        </activity>

        <activity
            android:name=".ui.activity.DialogActivity"
            android:screenOrientation="landscape" />
        <activity
            android:name=".ui.activity.recycle.FixedFocusPosRVActivity"
            android:screenOrientation="landscape" />

        <activity
            android:name=".ui.activity.recycle.MovedFocusPosRVActivity"
            android:screenOrientation="landscape" />

        <activity
            android:name=".ui.activity.FragmentDemoActivity"
            android:screenOrientation="landscape" />

        <activity android:name=".ui.activity.fusion.FusionVisionHomeActivity" />

        <activity android:name=".ui.activity.fusion.FusionVisionActivity" />

        <activity android:name=".ui.activity.fusion.MirrorContainerViewActivity" />

        <activity android:name=".ui.activity.recycle.RecycleViewHomeActivity" />

        <activity android:name=".ui.activity.api.APIActivity" />

        <activity android:name=".ui.activity.camera.CameraActivity" />

        <activity android:name=".ui.activity.tp.TPEventActivity" />

        <activity android:name=".ui.activity.player.VideoPlayActivity" />

        <activity android:name=".ui.activity.fusion.PAGActivity" />

        <activity android:name=".ui.activity.api.APIHomeActivity" />

        <activity android:name=".ui.activity.api.IMUActivity" android:exported="true" />

        <activity android:name=".ui.activity.camera.CameraHomeActivity" />

    </application>

</manifest>